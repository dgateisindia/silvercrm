# ========================================
# D-GATE SILVER CRM BACKEND
# Environment Configuration
# ========================================

# APPLICATION
NODE_ENV=development
PORT=4001
HOST=127.0.0.1

# FRONTEND
CORS_ORIGIN=http://localhost:5173

# MYSQL / MARIADB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=crm_dev_user
DB_PASSWORD=
DB_NAME=dgate_silver_crm

# AUTHENTICATION
# local: Development testing only
# platform: Verified D-GATE customer authentication
AUTH_MODE=local

# D-GATE PLATFORM INTEGRATION
# Configure after the Platform API contract is finalized.
PLATFORM_API_BASE_URL=
PLATFORM_SESSION_VERIFY_URL=
PLATFORM_TIMEOUT_MS=5000

# LOGGING
LOG_LEVEL=info
